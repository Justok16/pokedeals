# Projet Supabase (Settings > API dans le dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé publique VAPID (notifications push) -- générée une fois pour le projet,
# cf. scraper/CLAUDE.md / saas/README.md pour la génération complète
# (public + privée). Uniquement la partie PUBLIQUE va ici.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Clé service_role Supabase (Project Settings > API) -- SERVEUR uniquement,
# jamais NEXT_PUBLIC_. Utilisée par le webhook Stripe pour écrire l'état
# d'abonnement (RLS ne laisse jamais un utilisateur le faire lui-même).
SUPABASE_SERVICE_ROLE_KEY=

# Abonnement payant (Stripe) -- cf. saas/README.md section 4 pour la
# création du produit/prix/coupon/webhook dans le dashboard Stripe.
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_ID=price_xxxxx

# URL absolue du site (nécessaire pour les redirections Stripe Checkout) --
# http://localhost:3000 en local, l'URL Vercel/le domaine en prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
