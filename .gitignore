# =============================================================
# scraper/ -- bot Python (PokéDeals)
# =============================================================
scraper/__pycache__/
scraper/**/__pycache__/
*.pyc
*.pyo
scraper/.venv/
scraper/venv/

# Fichiers temporaires d'ecriture atomique (voir memoire_json.py / main.py)
*.tmp

# Secrets locaux (jamais utilises en prod, GitHub Actions passe par secrets.*)
scraper/.env
saas/.env*
!saas/.env.example

# Cache local du serveur MCP (scraper/mcp_pokedeals/) -- donnees temporaires
# reconstructibles a tout moment, jamais a committer.
scraper/mcp_pokedeals/.cache/

# =============================================================
# saas/ -- application web (Next.js)
# =============================================================
saas/node_modules/
saas/.next/
saas/out/
saas/build/
saas/.vercel/
saas/*.tsbuildinfo
saas/next-env.d.ts
saas/coverage/
saas/.pnp/
saas/.pnp.*
saas/.yarn/*
!saas/.yarn/patches
!saas/.yarn/plugins
!saas/.yarn/releases
!saas/.yarn/versions

# =============================================================
# Communs (tous OS / editeurs)
# =============================================================
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secrets locaux, partout dans le dépôt (audit vibe-security du 28/09/2026)
.env
.env.*
!.env.example
!**/.env.example

# Versions remplies des documents DIG16 (coordonnées réelles) : jamais dans le dépôt public
ai-business-lab/chasse-demande/supports/*-prive.html
ai-business-lab/chasse-demande/videos/test-du-pouce/controle/
ai-business-lab/chasse-demande/videos/test-du-pouce/son.m4a
ai-business-lab/chasse-demande/videos/test-du-pouce/musique.wav
