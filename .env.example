# Copie ce fichier en ".env" (a la racine du depot) et remplis les valeurs
# reelles si besoin. NE JAMAIS committer le fichier ".env" (deja exclu par
# .gitignore). Utilise uniquement par le serveur MCP (mcp_pokedeals/) --
# aucun rapport avec les secrets GitHub Actions de PokeDeals.

# --- TCGdex : API publique, GRATUITE, aucune cle necessaire ---
TCGDEX_BASE_URL=https://api.tcgdex.net/v2

# --- CardDex : cle optionnelle (limite de requetes plus basse sans cle) ---
# Cree une cle gratuite sur https://carddex.dev/ si besoin.
# ATTENTION : CARDDEX_BASE_URL par defaut est une deduction, pas une valeur
# confirmee -- verifie-la sur carddex.dev avant la premiere utilisation
# (voir mcp_pokedeals/providers/carddex.py).
CARDDEX_BASE_URL=https://api.carddex.dev
CARDDEX_API_KEY=

# --- Cardmarket : le guide de prix officiel ne demande AUCUNE cle ---
# CARDMARKET_API_KEY reste vide tant que l'API Marketplace (OAuth, compte
# vendeur) n'est pas implementee -- voir mcp_pokedeals/providers/cardmarket.py
CARDMARKET_BASE_URL=https://api.cardmarket.com/ws/v2.0
CARDMARKET_API_KEY=
CARDMARKET_PRICE_GUIDE_URL=https://downloads.s3.cardmarket.com/productCatalog/priceGuide/price_guide_6.json

# --- Cache local (en secondes) ---
MCP_CACHE_TTL_CARTES=86400
MCP_CACHE_TTL_SETS=86400
MCP_CACHE_TTL_PRIX=10800
