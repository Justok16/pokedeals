{
  "enabledPlugins": {
    "small-business@knowledge-work-plugins": true,
    "superpowers@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "permissions": {
    "allow": [
      "mcp__Canva",
      "mcp__Canva__*",
      "mcp__Google_Drive",
      "mcp__Google_Drive__*",
      "mcp__Vercel",
      "mcp__Vercel__*",
      "mcp__Gmail",
      "mcp__Gmail__*",
      "mcp__github",
      "mcp__OpenRush",
      "mcp__Resend",
      "mcp__Vercel__get_access_to_vercel_url",
      "mcp__Vercel__list_deployments",
      "mcp__Vercel__web_fetch_vercel_url",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__Claude_Code_Remote__get_trigger",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Metricool_Social_Media_Management__getScheduledPosts",
      "mcp__Metricool_Social_Media_Management__getBrandSettings",
      "mcp__Gmail__search_threads",
      "mcp__Gmail__get_thread",
      "mcp__Gmail__get_message",
      "mcp__Tavily__tavily_search",
      "mcp__Tavily__tavily_extract",
      "ReadNotifications",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Google_Drive__create_file",
      "mcp__Google_Drive__search_files",
      "mcp__Google_Drive__read_file_content",
      "mcp__Google_Drive__get_file_metadata",
      "mcp__Google_Drive__update_file",
      "mcp__Metricool_Social_Media_Management__updateScheduledPost",
      "mcp__Metricool_Social_Media_Management__createScheduledPost"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(pkill -f*)",
      "Bash(pgrep -f*)",
      "Bash(sudo *)",
      "Bash(chmod 777*)",
      "Bash(chmod -R 777*)",
      "Bash(ssh *)",
      "Bash(dd *of=/dev/*)"
    ]
  },
  "env": {
    "MCP_TIMEOUT": "120000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/secrets_avant_commit.sh",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "mcp__Metricool_Social_Media_Management__createScheduledPost|mcp__Zapier__execute_zapier_write_action|mcp__Zapier__execute_zapier_read_action",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quota_publications.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/python_syntaxe.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v detect-secrets-hook >/dev/null 2>&1 || pip install -q detect-secrets==1.5.0 2>&1 | tail -n 3 || true",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "python3 -c 'import yt_dlp' 2>/dev/null || pip install -q yt-dlp 2>&1 | tail -n 3 || true",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/reprise_finance.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 -c 'import imageio_ffmpeg' 2>/dev/null || python3 -m pip install -q imageio-ffmpeg 2>&1 | tail -n 1 || true",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verifier_avant.sh",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/reprise_finance.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/interdit_sans_reponse.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
